-- Example queries
SELECT s.student_id, CONCAT(s.first_name,' ',s.last_name) AS student,
       d.department_name
FROM students s JOIN departments d USING (department_id)
ORDER BY s.student_id;

SELECT c.course_code, c.course_name, COUNT(e.student_id) AS enrolled_students
FROM courses c LEFT JOIN enrollments e USING (course_id)
GROUP BY c.course_id, c.course_code, c.course_name
ORDER BY c.course_code;

SELECT s.student_id, CONCAT(s.first_name,' ',s.last_name) AS student,
       SUM(p.amount) AS total_paid
FROM students s JOIN payments p USING (student_id)
WHERE p.payment_status='Paid'
GROUP BY s.student_id, student
ORDER BY total_paid DESC;

SELECT d.department_name, COUNT(s.student_id) AS student_count
FROM departments d LEFT JOIN students s USING (department_id)
GROUP BY d.department_id, d.department_name;

SELECT semester, academic_year, grade, COUNT(*) AS grade_count
FROM enrollments GROUP BY semester, academic_year, grade ORDER BY grade;
