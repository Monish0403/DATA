### 4. Backend Handler: PHP (`save_game.php`)

This file receives the submitted form and inserts the record into MySQL:

```php
<?php
$host = "localhost";
$user = "root";
$pass = "";
$db   = "ludo_game";

$conn = new mysqli($host, $user, $pass, $db);

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $username = trim($_POST['username']);
    $color    = trim($_POST['color']);
    $room     = trim($_POST['room_code']);
    $dice     = (int)$_POST['dice_roll'];

    // 1. Insert or get player
    $stmt = $conn->prepare("INSERT INTO players (username, color_preference, games_played) 
                            VALUES (?, ?, 1) 
                            ON DUPLICATE KEY UPDATE games_played = games_played + 1");
    $stmt->bind_param("ss", $username, $color);
    $stmt->execute();
    $playerId = $stmt->insert_id ?: $conn->query("SELECT id FROM players WHERE username='$username'")->fetch_assoc()['id'];

    // 2. Insert or update game room
    $stmt = $conn->prepare("INSERT INTO game_sessions (room_code, current_turn, status) 
                            VALUES (?, ?, 'in_progress') 
                            ON DUPLICATE KEY UPDATE current_turn = ?");
    $stmt->bind_param("sss", $room, $color, $color);
    $stmt->execute();
    $gameId = $stmt->insert_id ?: $conn->query("SELECT id FROM game_sessions WHERE room_code='$room'")->fetch_assoc()['id'];

    // 3. Save the move
    $stmt = $conn->prepare("INSERT INTO game_moves (game_id, player_id, dice_roll) VALUES (?, ?, ?)");
    $stmt->bind_param("iii", $gameId, $playerId, $dice);
    
    if ($stmt->execute()) {
        echo "<script>alert('Move and player saved to MySQL!'); window.location.href='index.html';</script>";
    } else {
        echo "Error saving data: " . $stmt->error;
    }

    $stmt->close();
}
