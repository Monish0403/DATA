

### 1. MySQL Database Schema (`schema.sql`)

Run this in your MySQL console or phpMyAdmin:

```sql
CREATE DATABASE IF NOT EXISTS ludo_game;
USE ludo_game;

-- Store player profiles
CREATE TABLE IF NOT EXISTS players (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    color_preference ENUM('red', 'green', 'yellow', 'blue') DEFAULT 'red',
    games_played INT DEFAULT 0,
    games_won INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Store game sessions
CREATE TABLE IF NOT EXISTS game_sessions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    room_code VARCHAR(10) NOT NULL UNIQUE,
    current_turn VARCHAR(20) DEFAULT 'red',
    status ENUM('waiting', 'in_progress', 'finished') DEFAULT 'waiting',
    winner_id INT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (winner_id) REFERENCES players(id) ON DELETE SET NULL
);

-- Store individual moves/scores
CREATE TABLE IF NOT EXISTS game_moves (
    id INT AUTO_INCREMENT PRIMARY KEY,
    game_id INT NOT NULL,
    player_id INT NOT NULL,
    dice_roll TINYINT NOT NULL,
    piece_id VARCHAR(10),
    to_position INT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (game_id) REFERENCES game_sessions(id) ON DELETE CASCADE,
    FOREIGN KEY (player_id) REFERENCES players(id) ON DELETE CASCADE
);

```

